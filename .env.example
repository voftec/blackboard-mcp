# Base URL of your Blackboard Ultra instance
BLACKBOARD_BASE_URL=https://palermo.blackboard.com

# SSO login URL (optional; derived from BASE_URL for Universidad de Palermo)
# BLACKBOARD_LOGIN_URL=

# Browser channel Playwright uses for the visible login window:
# "chrome" (default, needs Google Chrome installed) or "chromium"
BLACKBOARD_BROWSER_CHANNEL=chrome

# Where the authenticated session is stored (cookies; keep private)
# BLACKBOARD_STATE_FILE=~/.blackboard-mcp/session.json
